#!/usr/bin/env bash
# Git pre-push hook — E2E gate.
#
# How it works:
#   1. If only doc files changed → skip E2E entirely (SKIPPED).
#   2. Otherwise → run the smoke E2E suite (PASSED/FAILED).
#   3. Any changed e2e/ file the smoke run's default project will not
#      actually collect (a canonical-harness spec, or a spec outside the
#      smoke allowlist) is reported as an explicit SKIPPED line — never
#      silently folded into a green "e2e passed" banner (#2592).
#
# See .claude/E2E_GATE.md for the full design rationale and
# scripts/dev/lib/pre-push-classify.sh for the classification logic itself
# (kept in a separate, unit-tested library — see
# scripts/dev/tests/pre-push-classify.test.sh).
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=../scripts/dev/lib/pre-push-classify.sh
source "$REPO_ROOT/scripts/dev/lib/pre-push-classify.sh"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion — nothing to check
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    exit 0
  fi

  # New branch: diff against merge-base with main
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base main "$local_sha" 2>/dev/null || echo "")
    if [ -z "$base" ]; then
      changed=$(git diff --name-only "${local_sha}^" "$local_sha" 2>/dev/null || echo "")
    else
      changed=$(git diff --name-only "$base" "$local_sha")
    fi
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha")
  fi

  # Filter to code-only files
  code_changes=$(echo "$changed" | filter_code_changes)

  if [ -z "$code_changes" ]; then
    echo "[pre-push] SKIPPED — doc-only changes, no e2e run needed."
    exit 0
  fi

  echo "[pre-push] Code changes detected:"
  echo "$code_changes" | sed 's/^/  /'
  echo ""

  # #2592: name any changed e2e/ file the smoke run below will NOT actually
  # collect, before running anything, so a later "e2e passed" banner can
  # never be mistaken for coverage of these files.
  uncovered_e2e=$(echo "$code_changes" | classify_e2e_coverage)
  if [ -n "$uncovered_e2e" ]; then
    echo "[pre-push] SKIPPED — the following changed e2e file(s) are not collected by the"
    echo "  'smoke' project this gate runs by default:"
    echo "$uncovered_e2e" | sed 's/^/    /'
    echo "  Run the matching suite manually before pushing, e.g.:"
    echo "    npm run test:e2e:canonical   (for e2e/canonical/**)"
    echo "    npm run test:e2e:journey     (for e2e/journey/**)"
    echo "    npx playwright test --project=full <file>   (any other project)"
    echo ""
  fi

  echo "━━━ pre-push: running e2e tests ━━━"
  # Ports are resolved per-worktree by scripts/run-e2e-local.sh itself
  # (.env.e2e.local when this worktree has explicit assigned ports, else
  # .env.e2e) — never hard-code them here, or this message drifts from
  # reality for every worktree that isn't on the repo's static defaults (#2078).
  E2E_LOCAL_FILE="$(git rev-parse --show-toplevel)/.env.e2e.local"
  E2E_FILE="$(git rev-parse --show-toplevel)/.env.e2e"
  RESOLVED_E2E_FILE="$E2E_FILE"
  [ -f "$E2E_LOCAL_FILE" ] && RESOLVED_E2E_FILE="$E2E_LOCAL_FILE"
  if [ -f "$RESOLVED_E2E_FILE" ]; then
    FE_URL=$(grep -E '^PLAYWRIGHT_BASE_URL=' "$RESOLVED_E2E_FILE" | tail -1 | cut -d= -f2-)
    BE_URL=$(grep -E '^BACKEND_BASE_URL=' "$RESOLVED_E2E_FILE" | tail -1 | cut -d= -f2-)
    echo "Backend: ${BE_URL:-see $RESOLVED_E2E_FILE}   Frontend: ${FE_URL:-see $RESOLVED_E2E_FILE} ($RESOLVED_E2E_FILE)"
  else
    echo "No .env.e2e / .env.e2e.local found — scripts/run-e2e-local.sh will report the error."
  fi
  echo ""

  npm run test:e2e:local

  echo ""
  echo "━━━ e2e passed — push proceeding ━━━"
  echo ""
done
