# .env.e2e.auth.example — template for the dedicated E2E Supabase Auth
# project (#2236 Part B). Copy is NOT enough to get a working file: the real
# .env.e2e.auth is GENERATED by scripts/dev/provision-e2e-auth-identities.sh,
# not hand-edited from this template.
#
# IMPORTANT — E2E_SUPABASE_SERVICE_ROLE_KEY IS DELIBERATELY ABSENT FROM THIS
# FILE AND FROM THE REAL .env.e2e.auth IT DESCRIBES. It is supplied ONLY as
# an ephemeral environment variable for a single invocation of
# provision-e2e-auth-identities.sh and is NEVER written to any file, never
# committed, never logged, and never passed to browser code. See
# docs/e2e-auth-provisioning.md for the full contract.
#
# The real .env.e2e.auth file:
#   - lives at the repo root
#   - is gitignored (see .gitignore's `!.env.e2e.auth.example` allow-line —
#     this template is committed, the real file never is)
#   - is created at mode 0600 by provision-e2e-auth-identities.sh and must
#     stay that way (local-fixture-backend.sh and verify-e2e-auth-project.sh
#     both fail closed if it is not exactly mode 600)
#
# Placeholders below are obviously fake — never real keys.

E2E_SUPABASE_PROJECT_REF=REPLACE_ME_e2e_project_ref
E2E_SUPABASE_URL=https://REPLACE_ME_e2e_project_ref.supabase.co
E2E_SUPABASE_ANON_KEY=REPLACE_ME_e2e_publishable_key

E2E_ADMIN_EMAIL=e2e-admin@udupi-e2e.invalid
E2E_ADMIN_PASSWORD=REPLACE_ME_generated_password

E2E_BROKER_EMAIL=e2e-broker@udupi-e2e.invalid
E2E_BROKER_PASSWORD=REPLACE_ME_generated_password

E2E_USER_EMAIL=e2e-user@udupi-e2e.invalid
E2E_USER_PASSWORD=REPLACE_ME_generated_password

E2E_DEALER_EMAIL=e2e-dealer@udupi-e2e.invalid
E2E_DEALER_PASSWORD=REPLACE_ME_generated_password
