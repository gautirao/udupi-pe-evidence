{
  "name": "udupi-property-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "build:dev": "npm run build:dev --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "typecheck:baseline": "node scripts/typecheck-baseline.mjs",
    "test:typecheck-baseline": "node --test scripts/typecheck-baseline.test.mjs",
    "test": "npm run test --workspace=apps/web",
    "test:watch": "npm run test:watch --workspace=apps/web",
    "test:coverage": "npm run test:coverage --workspace=apps/web",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:journey": "playwright test --project=journey",
    "test:e2e:full": "playwright test --project=full",
    "test:e2e:local": "bash scripts/run-e2e-local.sh",
    "test:e2e:headed": "bash scripts/run-e2e-local.sh --headed --workers=1",
    "test:e2e:watch": "bash scripts/e2e-watch.sh",
    "test:e2e:watch:slow": "bash scripts/e2e-watch.sh --slow",
    "test:e2e:canonical": "VITE_BUILD_SHA=$(git rev-parse HEAD) npm run build --workspace=apps/web && playwright test --config=playwright.canonical.config.ts",
    "prepare": "chmod +x scripts/run-e2e-local.sh .githooks/pre-push && git config core.hooksPath .githooks",
    "predev": "git config core.hooksPath .githooks",
    "prebuild": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.38.0"
  }
}
