# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Backend API (Spring Boot)
# Local dev: http://localhost:8085
# Production: https://your-render-service.onrender.com
VITE_API_BASE_URL=http://localhost:8085

# Sentry (optional — omit for local dev; Sentry runs in no-op mode without it)
# VITE_SENTRY_DSN=https://...@sentry.io/...

# E2E smoke tests (Playwright)
# PLAYWRIGHT_BASE_URL=http://localhost:8080
# BACKEND_BASE_URL=http://localhost:8085
# SMOKE_USER_EMAIL=user@example.com
# SMOKE_USER_PASSWORD=secret
# SMOKE_LISTING_ID=           # auto-populated by globalSetup if ADMIN creds set
# DEALER_EMAIL=dealer@example.com
# DEALER_PASSWORD=secret
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=secret
