# Running test_adapter_agricultural.py by hand drops a __pycache__/ into this committed
# artefact directory. The repo-root .gitignore's __pycache__ patterns are path-anchored
# to .claude/scripts/ and scripts/geography/, so they do not cover this directory — same
# reason data/imports/commercial-inventory-2575/ carries its own copy of this file.
__pycache__/
*.pyc
