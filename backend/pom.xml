<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>realestate-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Real Estate Backend</name>
    <description>Java Spring Boot backend for Udupi Property Explorer</description>

    <properties>
        <java.version>21</java.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security OAuth2 Resource Server (JWT validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway for backend-owned migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Boot Actuator (health check) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Prometheus registry — exposes /actuator/prometheus for scraping -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Jackson for JSON processing (included via spring-boot-starter-web) -->

        <!-- Bean Validation (Hibernate Validator) — required for @Valid/@Pattern on request bodies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Bucket4j: in-memory rate limiting for ingestion API key filter -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- Caffeine: in-process TTL cache for DiscoverSummary (#1760). Version managed by the
             Spring Boot BOM (spring-boot-dependencies -> caffeine.version), not pinned here. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Sentry error monitoring (jakarta variant required for Spring Boot 3.x) -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry-spring-boot-starter-jakarta</artifactId>
            <version>8.16.0</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        @{argLine}
                        -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                        -XX:+EnableDynamicAgentLoading
                        -Dnet.bytebuddy.experimental=true
                    </argLine>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            <!-- JaCoCo: local coverage reporting for SonarQube (org.jacoco:jacoco-maven-plugin).
                 @{argLine} above lets prepare-agent inject its javaagent alongside the existing
                 Mockito/ByteBuddy argLine instead of overwriting it. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Activate with `mvn -Pbroker-focus-it verify` to run BrokerMarketFocusIT
            tagged @Tag("integration") via failsafe, bypassing the surefire-level
            <excludedGroups>integration</excludedGroups>. Requires Docker.
            Added to support issue #1533.
        -->
        <profile>
            <id>broker-focus-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <argLine>
                                -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                                -XX:+EnableDynamicAgentLoading
                                -Dnet.bytebuddy.experimental=true
                            </argLine>
                            <includes>
                                <include>**/BrokerMarketFocusIT.java</include>
                            </includes>
                            <groups>integration</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Activate with `mvn -Pfailsafe-it verify` (or `mvn -Pfailsafe-it failsafe:integration-test`).
            Runs *IntegrationTest.java classes tagged @Tag("integration") via failsafe, bypassing
            the surefire-level <excludedGroups>integration</excludedGroups>. Default builds
            (`mvn test` / `mvn verify`) remain unchanged because the profile is opt-in.
            Added to support issue #1044 SchoolAreaMatchingIntegrationTest evidence capture.
        -->
        <profile>
            <id>failsafe-it</id>
            <build>
                <plugins>
                    <!--
                        Skip surefire entirely under this profile. The default surefire suite
                        contains pre-existing PostGIS-dependent ITs (AreaOverviewRollupJobIntegrationTest,
                        Phase1RegressionIT) that fail against plain postgres:15-alpine; running them
                        is out of scope for issue #1044. The new IT runs only via failsafe below.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <argLine>
                                -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                                -XX:+EnableDynamicAgentLoading
                                -Dnet.bytebuddy.experimental=true
                            </argLine>
                            <!--
                                Narrowed include: ONLY the issue #1044 IT. The broader
                                **/*IntegrationTest.java pattern would pull in pre-existing
                                PostGIS-broken ITs that are out of scope for this fix.
                            -->
                            <includes>
                                <include>**/SchoolAreaMatchingIntegrationTest.java</include>
                            </includes>
                            <groups>integration</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Activate with `mvn -Pdemand-signal-it failsafe:integration-test failsafe:verify`.
            Runs AreaDemandSignalIT tagged @Tag("integration") via failsafe, bypassing the
            surefire-level <excludedGroups>integration</excludedGroups>. Requires Docker
            (Testcontainers with postgis/postgis:15-3.4-alpine).
            Added to support issue #1532.
        -->
        <profile>
            <id>demand-signal-it</id>
            <build>
                <plugins>
                    <!-- Skip surefire entirely under this profile; only failsafe runs. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <argLine>
                                -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                                -XX:+EnableDynamicAgentLoading
                                -Dnet.bytebuddy.experimental=true
                            </argLine>
                            <!-- Narrowed include: AreaDemandSignalIT + AreaDemandSummaryIT (#1536). -->
                            <includes>
                                <include>**/AreaDemandSignalIT.java</include>
                                <include>**/AreaDemandSummaryIT.java</include>
                            </includes>
                            <groups>integration</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Activate with `mvn -Pbroker-demand-gap-it failsafe:integration-test failsafe:verify`.
            Runs BrokerDemandGapStateIT tagged @Tag("integration") via failsafe, bypassing the
            surefire-level <excludedGroups>integration</excludedGroups>. Requires Docker
            (Testcontainers with postgis/postgis:15-3.4-alpine).
            Added to support issue #1534.
        -->
        <profile>
            <id>broker-demand-gap-it</id>
            <build>
                <plugins>
                    <!-- Skip surefire entirely under this profile; only failsafe runs. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <argLine>
                                -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                                -XX:+EnableDynamicAgentLoading
                                -Dnet.bytebuddy.experimental=true
                            </argLine>
                            <!-- Narrowed include: ONLY BrokerDemandGapStateIT. -->
                            <includes>
                                <include>**/BrokerDemandGapStateIT.java</include>
                            </includes>
                            <groups>integration</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Activate with `mvn -f backend/pom.xml -Pwithin-polygon-srid-it verify`.
            Runs WithinPolygonSridIT tagged @Tag("integration") via failsafe as a regression guard
            for issue #1705 (ST_SetSRID fix in findLiveListingsWithinPolygon).
            Requires Docker (Testcontainers with postgis/postgis:15-3.4).
        -->
        <profile>
            <id>within-polygon-srid-it</id>
            <build>
                <plugins>
                    <!-- Skip surefire entirely under this profile; only failsafe runs. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <argLine>
                                -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                                -XX:+EnableDynamicAgentLoading
                                -Dnet.bytebuddy.experimental=true
                            </argLine>
                            <!-- Narrowed include: ONLY the issue #1705 SRID regression guard. -->
                            <includes>
                                <include>**/WithinPolygonSridIT.java</include>
                            </includes>
                            <groups>integration</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Activate with `mvn -f backend/pom.xml -Pstale-listings-it verify`.
            Runs ListingRepositoryStaleListingsIT tagged @Tag("integration") via failsafe as a
            regression guard for issue #1794 (admin stale-listing visibility query).
            Requires Docker (Testcontainers with postgres:15-alpine).
        -->
        <profile>
            <id>stale-listings-it</id>
            <build>
                <plugins>
                    <!-- Skip surefire entirely under this profile; only failsafe runs. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <argLine>
                                -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                                -XX:+EnableDynamicAgentLoading
                                -Dnet.bytebuddy.experimental=true
                            </argLine>
                            <!-- Narrowed include: ONLY the issue #1794 stale-listings regression guard. -->
                            <includes>
                                <include>**/ListingRepositoryStaleListingsIT.java</include>
                            </includes>
                            <groups>integration</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Activate with `mvn -f backend/pom.xml -Pnotification-mark-all-read-it verify`.
            Runs NotificationMarkAllAsReadIT tagged @Tag("integration") via failsafe as a
            regression guard for issue #2072 PR #2392 review finding (missing @Transactional
            on the bulk mark-all-read endpoint). Requires Docker (Testcontainers with
            postgis/postgis:15-3.4-alpine).
        -->
        <profile>
            <id>notification-mark-all-read-it</id>
            <build>
                <plugins>
                    <!-- Skip surefire entirely under this profile; only failsafe runs. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <argLine>
                                -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
                                -XX:+EnableDynamicAgentLoading
                                -Dnet.bytebuddy.experimental=true
                            </argLine>
                            <!-- Narrowed include: ONLY the issue #2072 mark-all-read regression guard. -->
                            <includes>
                                <include>**/NotificationMarkAllAsReadIT.java</include>
                            </includes>
                            <groups>integration</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
