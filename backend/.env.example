# backend/.env.example
# Template for local backend development environment variables.
# Copy this file to backend/.env and fill in the real values before starting the backend.
#   cp backend/.env.example backend/.env
# NEVER commit backend/.env — it is gitignored. It contains real credentials.

# ============================================================
# REQUIRED — no defaults; run-local.sh will fail without these
# ============================================================

# Supabase Postgres host (e.g. db.<project-ref>.supabase.co)
SUPABASE_DB_HOST=your-supabase-db-host.example.com

# Supabase Postgres user (typically "postgres")
SUPABASE_DB_USER=your-supabase-db-user

# Supabase Postgres password
SUPABASE_DB_PASSWORD=changeme-supabase-db-password

# Supabase project reference ID (used as JWT issuer, found in project settings)
SUPABASE_PROJECT_REF=your-supabase-project-ref

# AI service API key
AI_API_KEY=placeholder-ai-api-key

# ============================================================
# OPTIONAL — safe defaults are shown; uncomment to override
# ============================================================

# Local server port (default: 8085)
# SERVER_PORT=8085

# Supabase Postgres port (default: 6543)
# SUPABASE_DB_PORT=6543

# Supabase Postgres database name (default: postgres)
# SUPABASE_DB_NAME=postgres

# AI service base URL (default: Google Gemini endpoint)
# AI_API_URL=https://placeholder-ai-api-url.example.com

# AI model name (default: gemini-2.0-flash)
# AI_MODEL=gemini-2.0-flash
