# Raw source data (large files — Kaggle CSVs, GeoJSONs — keep local only)
scripts/data/schools/raw/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

backend/target/*

# Lockfiles (npm only — prevent Cloudflare from auto-selecting bun)
bun.lockb

# Secrets (SEC-1 remediation)
.env
.env_*
.env.*
*.env
*.env.*
backend/.env
backend/.env_*
backend/.env.*
backend/*.env
# Allow example/template files that show required env var structure (no real secrets)
!.env.e2e.example
!.env.seed.example
.claude/settings.local.json

# Playwright test output
playwright-report/
test-results/

# Playwright E2E fixture — generated by global-setup, consumed by specs
e2e/.test-listing-id

# Playwright storageState files — contain session tokens, must never be committed
e2e/fixtures/*-auth.json
coverage/*

# Claude Code local development artifacts
.claude/worktrees/
.claude/state/
.claude/handoffs/

# OpenAI gate run artifacts — only .gitkeep and README.md committed
.claude/openai-gates/*
!.claude/openai-gates/.gitkeep
!.claude/openai-gates/README.md

# Python venv and bytecode for gate scripts
.claude/scripts/.venv/
.claude/scripts/**/__pycache__/
.claude/scripts/**/*.pyc

# Generated/throwaway artefacts — verification screenshots, scratch dirs, runtime locks
# (already-tracked screenshots remain tracked; this only stops new ones being added)
screenshots/
.claude/tmp/
.claude/scheduled_tasks.lock
.claude/reports/

