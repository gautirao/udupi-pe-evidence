# Raw source data (large files — Kaggle CSVs, GeoJSONs — keep local only)
scripts/data/schools/raw/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

apps/api/target/*

# Lockfiles (npm only — prevent Cloudflare from auto-selecting bun)
bun.lockb

# Secrets (SEC-1 remediation)
.env
.env_*
.env.*
*.env
*.env.*
apps/api/.env
apps/api/.env_*
apps/api/.env.*
apps/api/*.env
# Allow example/template files that show required env var structure (no real secrets)
!.env.e2e.example
!.env.e2e.auth.example
!.env.seed.example
!apps/api/.env.example
!apps/web/.env.example
.claude/settings.local.json

# Playwright test output
playwright-report/
test-results/

# Playwright E2E fixture — generated by global-setup, consumed by specs
e2e/.test-listing-id

# Playwright storageState files — contain session tokens, must never be committed
e2e/fixtures/*-auth.json
coverage/*

# Discover-V2 parity harness (issue #2076) — runtime-resolved node-role map
# and its own storageState/report output. Node keys are server-generated and
# environment-specific; never commit a resolved map (see
# e2e-parity/support/parity-nodes.ts). Auth fixtures never committed for the
# same reason as e2e/fixtures/*-auth.json above.
e2e-parity/.parity-node-roles.json
e2e-parity/fixtures/*-auth.json
playwright-report-parity/
test-results-parity/
playwright-report-mock-capture/
test-results-mock-capture/

# Local DB dump files — never commit (may contain PII or large data)
tmp/*.dump
tmp/*.sql
tmp/*.backup
*.dump
*.backup

# Claude Code local development artifacts
.claude/worktrees/
.claude/state/
.claude/handoffs/

# OpenAI gate run artifacts — only .gitkeep and README.md committed
.claude/openai-gates/*
!.claude/openai-gates/.gitkeep
!.claude/openai-gates/README.md

# Python venv and bytecode for gate scripts
.claude/scripts/.venv/
.claude/scripts/**/__pycache__/
.claude/scripts/**/*.pyc

# Generated/throwaway artefacts — verification screenshots, scratch dirs, runtime locks
# (already-tracked screenshots remain tracked; this only stops new ones being added)
screenshots/
.claude/tmp/
.claude/scheduled_tasks.lock
.claude/reports/

# City geography preparation pipeline (issue #1900) — never commit the large
# Geofabrik OSM extract or any raw/full city output; only tiny fixtures,
# checksums, and the one small compat-IT sample batch under
# apps/api/src/test/resources/area-onboarding/ are committed.
*.osm.pbf
southern-zone*
scripts/geography/output/
scripts/geography/**/__pycache__/
scripts/geography/**/*.pyc
# User-correction rework (--source-manifest / --canonical-area-inventory):
# an operator's REAL local source manifest (which embeds a real local PBF
# path) or a real canonical-area-inventory export from production is never
# committed — only the tiny *_sample.json fixtures under
# scripts/geography/fixtures/ are. Operators should name local drafts with
# a *.local.json suffix to keep them out of git by convention.
scripts/geography/*.source-manifest.local.json
scripts/geography/*.canonical-area-inventory.local.*

