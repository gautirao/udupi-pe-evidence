 hover:border-foreground/30 hover:text-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-land-plot h-5 w-5 text-muted-foreground" aria-hidden="true"><path d="m12 8 6-3-6-3v10"></path><path d="m8 11.99-5.5 3.14a1 1 0 0 0 0 1.74l8.5 4.86a2 2 0 0 0 2 0l8.5-4.86a1 1 0 0 0 0-1.74L16 12"></path><path d="m6.49 12.85 11.02 6.3"></path><path d="M17.51 12.85 6.5 19.15"></path></svg><span class="text-sm font-medium leading-tight">Commercial Land</span></button></div></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Listing Purpose</label><div><div role="group" aria-label="Listing purpose" class="inline-flex rounded-lg bg-muted p-1"><button type="button" aria-pressed="true" class="rounded-md px-5 py-1.5 text-sm font-medium transition-colors bg-card text-foreground shadow-sm">For Sale</button><button type="button" aria-pressed="false" class="rounded-md px-5 py-1.5 text-sm font-medium transition-colors text-muted-foreground hover:text-foreground">For Rent</button></div></div></div></div></div><div class="rounded-lg border bg-card text-card-foreground shadow-sm"><div class="flex flex-col space-y-1.5 p-6 pb-4"><div class="flex items-start justify-between gap-3"><div class="space-y-1"><h3 class="tracking-tight text-lg font-semibold">Property details</h3></div></div></div><div class="mx-6 border-t"></div><div class="p-6 space-y-5 pt-5"><div class="space-y-4" data-testid="agri-fields-section"><h3 class="text-sm font-medium text-foreground">Agricultural Land Details</h3><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="landCategory">Land Category</label><select data-select-value="empty"><span id="landCategory"><span>Select land category</span></span><option value="FARMLAND">Farmland</option><option value="PLANTATION">Plantation</option><option value="FARM_PLOT">Farm plot</option><option value="AGRICULTURAL_PLOT">Agricultural plot</option><option value="OTHER">Other</option></select></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="waterSource">Water Source</label><select data-select-value="empty"><span id="waterSource"><span>Select water source</span></span><option value="BOREWELL">Borewell</option><option value="WELL">Open well</option><option value="RIVER">River</option><option value="RAIN_FED">Rain-fed</option><option value="POND">Pond</option><option value="STREAM">Stream</option><option value="NOT_AVAILABLE">Not available</option><option value="OTHER">Other</option></select></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="farmhouseAvailable">Farmhouse Available</label><select data-select-value="empty"><span id="farmhouseAvailable"><span>Not specified</span></span><option value="true">Yes</option><option value="false">No</option></select></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="fencingDone">Fencing Done</label><select data-select-value="empty"><span id="fencingDone"><span>Not specified</span></span><option value="true">Yes</option><option value="false">No</option></select></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="soilType">Soil Type</label><select data-select-value="empty"><span id="soilType"><span>Select soil type</span></span><option value="RED_LATERITE">Red laterite</option><option value="BLACK_COTTON">Black cotton</option><option value="ALLUVIAL">Alluvial</option><option value="SANDY_LOAM">Sandy loam</option><option value="CLAY">Clay</option><option value="OTHER">Other</option></select></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="roadAccess">Road Access</label><select data-select-value="empty"><span id="roadAccess"><span>Select road access</span></span><option value="TARRED_ROAD">Tarred road</option><option value="KACHCHA_ROAD">Kachcha road</option><option value="HIGHWAY_FRONTAGE">Highway frontage</option><option value="NO_ROAD_ACCESS">No road access</option><option value="OTHER">Other</option></select></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="cultivationStatus">Cultivation Status</label><select data-select-value="empty"><span id="cultivationStatus"><span>Select cultivation status</span></span><option value="CULTIVATED">Cultivated</option><option value="FALLOW">Fallow</option><option value="ARECA_PLANTATION">Areca plantation</option><option value="COCONUT_PLANTATION">Coconut plantation</option><option value="PARTIALLY_CULTIVATED">Partially cultivated</option><option value="OTHER">Other</option></select></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="ownershipType">Ownership Type</label><select data-select-value="empty"><span id="ownershipType"><span>Select ownership type</span></span><option value="FREEHOLD">Freehold</option><option value="INHERITED">Inherited</option><option value="PATTA">Patta</option><option value="SURVEY_SETTLEMENT">Survey settlement</option><option value="KATHA">Katha</option><option value="REVENUE">Revenue</option><option value="OTHER">Other</option></select></div><div class="space-y-2"><label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="agriConversionStatus">Conversion Status (optional)</label><select data-select-value="empty"><span id="agri