# E2E Seed Script — Environment Variables
# Copy to .env.seed (gitignored) and fill in real values.
# Run: source .env.seed && node scripts/seed-discover-listings.mjs

SEED_SUPABASE_URL=https://your-project.supabase.co
SEED_SUPABASE_KEY=your-supabase-publishable-key
SEED_BROKER_EMAIL=your-broker@example.com
SEED_BROKER_PASSWORD=your-broker-password
SEED_ADMIN_EMAIL=your-admin@example.com
SEED_ADMIN_PASSWORD=your-admin-password
SEED_DB_HOST=your-db-host.supabase.com
SEED_DB_PORT=6543
SEED_DB_USER=postgres.your-project-ref
SEED_DB_NAME=postgres
SEED_DB_PASSWORD=your-db-password
SEED_BACKEND_URL=http://localhost:8085

# Optional: absolute path to a jpg to use as listing image.
# If absent, image upload is skipped entirely.
# SEED_IMAGE_PATH=/path/to/image.jpg
