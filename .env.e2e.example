# E2E test environment — copy to .env.e2e and replace ALL values.
# Do NOT commit .env.e2e to git.
# See docs/TESTING.md for setup instructions including how to create Supabase test users.
#
# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY are NOT needed here —
# they are read from the root .env file automatically when Vite starts.

PLAYWRIGHT_BASE_URL=http://localhost:5174
BACKEND_BASE_URL=http://localhost:8085

# Real Supabase test user accounts — must exist in your Supabase project.
# Tests skip gracefully when these are empty.
SMOKE_USER_EMAIL=e2e-user@your-domain.com
SMOKE_USER_PASSWORD=change-me
BROKER_EMAIL=e2e-broker@your-domain.com
BROKER_PASSWORD=change-me
# DEALER_EMAIL and DEALER_PASSWORD are deprecated aliases — use BROKER_EMAIL / BROKER_PASSWORD instead.
# DEALER_EMAIL=e2e-broker@your-domain.com
# DEALER_PASSWORD=change-me
ADMIN_EMAIL=e2e-admin@your-domain.com
ADMIN_PASSWORD=change-me
