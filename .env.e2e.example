# E2E test environment — copy to .env.e2e and replace ALL values.
# Do NOT commit .env.e2e to git.
# See docs/TESTING.md for setup instructions including how to create Supabase test users.

PLAYWRIGHT_BASE_URL=http://localhost:8080
BACKEND_BASE_URL=http://localhost:8085

# Supabase project credentials (same as your local .env or .env.local)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Real Supabase test user accounts — must exist in your Supabase project.
# Placeholder @example.com values will cause auth tests to skip (not fail).
SMOKE_USER_EMAIL=e2e-user@your-domain.com
SMOKE_USER_PASSWORD=change-me
DEALER_EMAIL=e2e-dealer@your-domain.com
DEALER_PASSWORD=change-me
ADMIN_EMAIL=e2e-admin@your-domain.com
ADMIN_PASSWORD=change-me
